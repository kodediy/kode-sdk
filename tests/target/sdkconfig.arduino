# The Arduino build (arduino/sdkconfig.sdk, read after this file) on an app's
# own defaults, so the lines of sdkconfig.defaults that are not an app's go
# back - the role, the channel, the scheduler, the pixel accelerator's passes
# and FreeRTOS's task list.
CONFIG_KODEOS_BOOT_ROLE_APP=y
CONFIG_KODEOS_CHANNEL=n
CONFIG_KODE_SCHEDULER=n
CONFIG_KODE_COMPOSE=n
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
# Optimised for size, as the Arduino libraries are built: what GCC warns of
# depends on the optimisation (-Wformat-truncation sees more at -Os than at
# ESP-IDF's default -Og), and the libraries' build stops on those warnings.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
