# cmake -DIN=<file> -DOUT=<file.c> -DNAME=<symbol> -P embed.cmake
# Writes <file> as `const unsigned char NAME[]` plus `const size_t NAME_len`, so a binary asset is compiled in
# and nothing is read from disk at run time.
file(READ "${IN}" HEX HEX)
string(LENGTH "${HEX}" HEX_LEN)
math(EXPR BYTES "${HEX_LEN} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARRAY "${HEX}")
file(WRITE "${OUT}"
     "/* Generated by embed.cmake from ${IN}. Do not edit. */\n"
     "#include <stddef.h>\n"
     "const unsigned char ${NAME}[] = {${ARRAY}};\n"
     "const size_t ${NAME}_len = ${BYTES};\n")
