# The Kode Dot's silicon and wiring, read first by kodeOS and by every app.
# Each comment ends with the component that declares the option.

# ---- Flash ------------------------------------------------------------------
# 32 MB NOR flash (GD25Q256). (ESP-IDF)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# The cache maps the whole 32 MB, not only the first 16 MB. (ESP-IDF)
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y
# A custom partition table; each project gives its path. (ESP-IDF)
CONFIG_PARTITION_TABLE_CUSTOM=y
# The table at 0x8000, where the Arduino core looks for it. (ESP-IDF)
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---- PSRAM ------------------------------------------------------------------
# 32 MB of in-package PSRAM. (ESP-IDF)
CONFIG_SPIRAM=y
# HEX mode, the only one this package has. (ESP-IDF)
CONFIG_SPIRAM_MODE_HEX=y
# 250 MHz; needs a rev v3.0 die. (ESP-IDF)
CONFIG_SPIRAM_SPEED_250M=y
# Keep booting if the PSRAM is not detected. (ESP-IDF)
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# A plain malloc() takes PSRAM; internal RAM is asked for by capability.
# (ESP-IDF)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# No walk over all 32 MB on every boot: it costs about a second each time.
# `test component=psram` tests the PSRAM, more thoroughly. (ESP-IDF)
CONFIG_SPIRAM_MEMTEST=n

# ---- Vendor stacks kept out of internal RAM ---------------------------------
# esp-hosted's 88 KB of transport pools in PSRAM. (esp_hosted)
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# NimBLE's 32 KB of buffers and tables in PSRAM. (ESP-IDF)
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# mbedTLS's buffers in PSRAM: a session holds about 30 KB of the internal pool
# and a renewal is two handshakes while it is up, which would take the pool to
# the 64 KB floor of `test component=mem`. (ESP-IDF)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Parallel IO's handlers in flash, not IRAM: the LF tag emulation loops one
# buffer in hardware with no callback, so their latency buys nothing. (ESP-IDF)
CONFIG_PARLIO_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_PARLIO_RX_ISR_HANDLER_IN_IRAM=n

# ---- MQTT -------------------------------------------------------------------
# esp-mqtt's MQTT 5 code: the Kode channel keeps a persistent session with an
# expiry, which 3.1.1 cannot ask for. Each client still picks its version, and
# a bench client stays on 3.1.1. (esp-mqtt)
CONFIG_MQTT_PROTOCOL_5=y

# ---- Cache and MMU ----------------------------------------------------------
# 128 KB of L2 cache; 512 KB does not boot. (ESP-IDF)
CONFIG_CACHE_L2_CACHE_128KB=y
# 64 KB MMU pages, the alignment of the apps region. (ESP-IDF)
CONFIG_MMU_PAGE_SIZE_64KB=y

# ---- Console ----------------------------------------------------------------
# Console on the native USB; UART0's pins go to the audio codec. (ESP-IDF)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- ESP32-C5 radio coprocessor ---------------------------------------------
# The coprocessor is an ESP32-C5. (ESP-IDF)
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
# The same, for esp-hosted. (esp_hosted)
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
# esp-hosted only when KODEOS_RADIO selects it: built in, it claims the SDMMC
# controller before app_main, radio or not. (esp_hosted)
CONFIG_ESP_HOSTED_ENABLED=n
# SDIO slot 1 with this board's pins and the C5's reset on GPIO23. (esp_hosted)
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=51
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=49
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=48
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=53
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=52
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=23
# 40 MHz, the validated maximum for this PCB. (esp_hosted)
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
# 4-bit SDIO bus. (esp_hosted)
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# Reach the C5's own pins by RPC; the SD card-detect is one. (esp_hosted)
CONFIG_ESP_HOSTED_ENABLE_GPIO_EXPANDER=y
# esp-hosted resets the C5 only when the SDIO card will not answer; kdrv_radio
# decides the rest, so a C5 parked across a restart can stay up. (esp_hosted)
CONFIG_ESP_HOSTED_SLAVE_RESET_ONLY_IF_NECESSARY=y
# A silent C5 does not reboot the P4: the link reports it lost. (esp_hosted)
# CONFIG_ESP_HOSTED_HOST_RESTART_NO_COMMUNICATION_WITH_SLAVE is not set

# ---- BLE host ---------------------------------------------------------------
# What KODEOS_BLE needs, here and not in a firmware's own defaults because
# BT_NIMBLE_ENABLED is a choice no option can select and every app reads this
# file first. Off until a firmware turns it on with CONFIG_BT_ENABLED=y and
# CONFIG_KODEOS_BLE=y, so an app without Bluetooth does not carry the stack.
# NimBLE's buffers in PSRAM are set under "Vendor stacks" below.
# BLE host only: NimBLE with no controller of its own. (ESP-IDF)
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
# NimBLE reaches the C5's controller over esp-hosted. (esp_hosted)
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y

# Bonds survive a reboot. (ESP-IDF)
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Pairing's ECDH on mbedTLS and the hardware ECC block. (ESP-IDF)
CONFIG_BT_NIMBLE_CRYPTO_STACK_MBEDTLS=y
# NimBLE at WARNING: its INFO lines loop through the BLE console. (ESP-IDF)
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Enough mbufs for the console's notifications. (ESP-IDF)
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
# One store keeps every bond's subscriptions: the three bonds of
# BT_NIMBLE_MAX_BONDS times the seven one link can hold (Service Changed, the
# console's TX, the mirror's pipe, an app's four characteristics). kdrv_ble.c
# asserts the product fits. (ESP-IDF)
CONFIG_BT_NIMBLE_MAX_CCCDS=21

# ---- Clocks -----------------------------------------------------------------
# CPU at 400 MHz. (ESP-IDF)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
# RTC slow clock from the 32.768 kHz crystal, not the internal RC. (ESP-IDF)
CONFIG_RTC_CLK_SRC_EXT_CRYS=y

# ---- System -----------------------------------------------------------------
# 1 ms FreeRTOS tick. (ESP-IDF)
CONFIG_FREERTOS_HZ=1000
# Two thread-local pointers per task: index 0 is ESP-IDF's pthread layer, index 1
# is khal_task_slot_get()/set(), the standard layer's one pointer per task. (ESP-IDF)
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
# A task's slot is freed when the task ends: khal_task_slot_set_owned() needs
# the deletion callbacks, and khal_system_esp.c stops the build without them. (ESP-IDF)
CONFIG_FREERTOS_TLSP_DELETION_CALLBACKS=y
# 8 KB main task: kode_init() starts the owner AOs an app links on it. (ESP-IDF)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The DSI interrupt keeps running while the flash cache is off. (ESP-IDF)
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
# Allows the experimental 32-bit cache mapping above. (ESP-IDF)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# Trust a chain that ends in a root the bundle still has but reaches it
# through a cross-signature from one it dropped: Google's servers, api.kode.diy
# among them, send GTS Root R1 signed by GlobalSign Root CA, which is no
# longer in the bundle. Costs about 700 bytes of heap per handshake. (ESP-IDF)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# Silent bootloader. (ESP-IDF)
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# DEBUG logs stay compiled, for `log_level`. (ESP-IDF)
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Only for a die older than rev v3.0; then fix the CPU and PSRAM speeds too.
# (ESP-IDF)
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# CONFIG_ESP32P4_REV_MIN_100=y

# ---- LVGL -------------------------------------------------------------------
# LVGL allocates from PSRAM through kui_mem.c, with no fallback. (LVGL)
CONFIG_LV_USE_CUSTOM_MALLOC=y
# Cache shadow corners instead of redrawing them. (LVGL)
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=128
# Refresh every 16 ms, to catch each 16.8 ms refresh of the panel. (LVGL)
CONFIG_LV_DEF_REFR_PERIOD=16
# Draw on both cores, 32 KB stacks in PSRAM for ThorVG, at the GUI's priority. (LVGL)
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_DRAW_THREAD_STACK_SIZE=32768
CONFIG_LV_DRAW_THREAD_PRIO=3
# RGB565: the CO5300 cannot run 410x502 at 24 bpp. (LVGL)
CONFIG_LV_COLOR_FORMAT_RGB565=y
# Colour mixes round half up, as in LVGL 9.5. (LVGL)
CONFIG_LV_COLOR_MIX_ROUND_OFS=128
# The QR code of the empty launcher. (LVGL)
CONFIG_LV_USE_QRCODE=y
# lv_obj_set_name_static(), which the kit's screens call. (LVGL)
CONFIG_LV_USE_OBJ_NAME=y
# Fonts lv_font_conv compressed, as it does without --no-compress: without
# this, LVGL draws none of their glyphs. The kit's faces are plain. (LVGL)
CONFIG_LV_USE_FONT_COMPRESSED=y
